/* MISSION 10 — MEMORIES GALLERY */
.memories-scene {
  position: relative;
  z-index: 2;
  width: min(1100px, 92%);
  max-height: 82vh;
  margin: 0 auto;
  padding: 35px 0 55px;
  overflow-y: auto;
  text-align: center;
  scrollbar-width: thin;
  scrollbar-color: rgba(211, 190, 255, 0.4) transparent;
}

.memories-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  margin: 35px auto 25px;
}

.memory-card {
  overflow: hidden;
  text-align: left;
  border: 1px solid rgba(220, 205, 255, 0.16);
  border-radius: 14px;
  background: rgba(17, 14, 35, 0.78);
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.22);
  opacity: 0;
}

.memory-image-wrap {
  position: relative;
  width: 100%;
  height: 230px;
  overflow: hidden;
}

.memory-image-wrap img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.memory-card:hover .memory-image-wrap img {
  transform: scale(1.06);
}

.memory-number {
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 6px 10px;
  color: white;
  font-size: 11px;
  letter-spacing: 2px;
  border: 1px solid rgba(255,255,255,0.3);
  border-radius: 20px;
  background: rgba(10, 8, 25, 0.55);
}

.memory-info {
  padding: 17px 18px 20px;
}

.memory-info h3 {
  margin: 0 0 7px;
  color: #f3eaff;
  font-family: Georgia, serif;
  font-size: 19px;
  font-weight: 400;
}

.memory-info p {
  margin: 0;
  color: rgba(235, 225, 255, 0.65);
  font-size: 12px;
  line-height: 1.6;
}

.memories-button {
  display: block;
  margin: 25px auto 10px;
  padding: 13px 23px;
  color: #f5eaff;
  font-size: 11px;
  letter-spacing: 2px;
  border: 1px solid rgba(220, 190, 255, 0.45);
  border-radius: 30px;
  background: rgba(150, 105, 210, 0.13);
  cursor: pointer;
  transition: background 0.3s, transform 0.3s;
}

.memories-button:hover {
