}

.music-toggle-global:hover {
  background: rgba(100, 70, 150, 0.55);
  border-color: rgba(235, 210, 255, 0.8);
}

.music-toggle-global span {
  font-size: 17px;
}

@media (max-width: 480px) {
  .music-toggle-global {
    top: 14px;
