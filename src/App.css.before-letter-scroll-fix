.universe {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 100svh;
  overflow: hidden;
  isolation: isolate;
  background:
    radial-gradient(ellipse at 50% 45%, #17102a 0%, #090714 42%, #03030b 78%);
}

.star-canvas {
  position: absolute;
  inset: 0;
  z-index: -1;
  width: 100%;
  height: 100%;
}

.ambient-glow {
  position: absolute;
  z-index: -1;
  width: 380px;
  height: 380px;
  border-radius: 50%;
  filter: blur(110px);
  pointer-events: none;
  opacity: 0.22;
  animation: glowPulse 8s ease-in-out infinite alternate;
}

.glow-one {
  top: 5%;
  left: 8%;
  background: #7651bd;
}

.glow-two {
  right: 5%;
  bottom: 0;
  background: #a43d72;
  animation-delay: -4s;
}

.hero-content,
.envelope-scene,
.letter-scene {
  width: min(90%, 760px);
  padding: 40px 0 70px;
  text-align: center;
}

.eyebrow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  margin: 0 0 27px;
  color: #c9a9d0;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 4px;
}

.eyebrow-line {
  width: 28px;
  height: 1px;
  background: linear-gradient(90deg, transparent, #b68bbd);
}

.eyebrow-line:last-child {
  transform: rotate(180deg);
}

.hero-title {
  margin: 0;
  color: #fff9ff;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(66px, 12vw, 132px);
  font-weight: 300;
  line-height: 0.82;
  letter-spacing: 5px;
  text-shadow: 0 0 55px rgba(218, 166, 231, 0.16);
}

.hero-title span {
  display: block;
  margin-top: 17px;
  color: #d6b4d9;
  font-size: 1.16em;
  font-style: italic;
  letter-spacing: 15px;
  text-shadow: 0 0 35px rgba(210, 151, 224, 0.35);
}

.hero-description {
  margin: 39px 0 36px;
  color: #c2b9cb;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(19px, 3vw, 25px);
  font-weight: 300;
  line-height: 1.55;
  letter-spacing: 0.6px;
}

.enter-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  min-width: 235px;
  padding: 15px 21px;
  border: 1px solid rgba(220, 182, 222, 0.48);
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.035);
  color: #f6eaf7;
  cursor: pointer;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 2.4px;
  transition: all 0.35s ease;
}

.enter-button:hover {
  transform: translateY(-3px);
  border-color: #e7bce9;
  background: rgba(199, 143, 205, 0.12);
  box-shadow: 0 0 30px rgba(196, 130, 203, 0.16);
}

.button-arrow {
  color: #e5b8e5;
  font-size: 16px;
}

/* Envelope scene */

.envelope-scene {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.scene-title {
  margin: 0;
  color: #f8eefa;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(36px, 6vw, 58px);
  font-weight: 300;
}

.scene-subtitle {
  margin: 12px 0 35px;
  color: #c2b9cb;
  font-family: "Cormorant Garamond", serif;
  font-size: 21px;
}

.envelope-button {
  position: relative;
  display: block;
  width: 280px;
  height: 205px;
  padding: 0;
  border: 0;
  background: transparent;
  cursor: pointer;
  perspective: 1000px;
  animation: envelopeFloat 4s ease-in-out infinite;
}

.envelope-button:disabled {
  cursor: default;
}

.envelope {
  position: relative;
  width: 100%;
  height: 175px;
  margin-top: 20px;
  transform-style: preserve-3d;
  filter: drop-shadow(0 22px 35px rgba(0, 0, 0, 0.35));
}

.envelope-back {
  position: absolute;
  inset: 0;
  z-index: 1;
  border: 1px solid rgba(255, 220, 239, 0.55);
  border-radius: 4px;
  background: linear-gradient(145deg, #d9b8d7, #986b9e);
}

.envelope-letter {
  position: absolute;
  z-index: 2;
  top: 10px;
  left: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(100% - 24px);
  height: 145px;
  border-radius: 3px;
  background: #fff8f0;
  color: #966a8c;
}

.letter-mini-heart {
  color: #c477a5;
  font-size: 25px;
}

.letter-mini-text {
  margin-top: 5px;
  font-family: "Cormorant Garamond", serif;
  font-size: 18px;
  font-style: italic;
}

.envelope-front {
  position: absolute;
  inset: 0;
  z-index: 2;
  border-radius: 4px;
  background: linear-gradient(145deg, #c99ac5, #8b608e);
  clip-path: polygon(0 0, 50% 58%, 100% 0, 100% 100%, 0 100%);
}

.envelope-flap {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 4;
  width: 100%;
  height: 100%;
  border-radius: 4px;
  background: linear-gradient(145deg, #e3c5df, #a77aab);
  clip-path: polygon(0 0, 100% 0, 50% 58%);
  transform-origin: top center;
  backface-visibility: visible;
}

.envelope-seal {
  position: absolute;
  top: 67px;
  left: 50%;
  z-index: 5;
  display: grid;
  width: 37px;
  height: 37px;
  place-items: center;
  transform: translateX(-50%);
  border: 1px solid rgba(255, 240, 250, 0.7);
  border-radius: 50%;
  background: #a45f88;
  color: #fff0fa;
  font-size: 17px;
  box-shadow: 0 3px 12px rgba(55, 22, 52, 0.2);
  transition: opacity 0.3s ease;
}

.envelope-button.opened .envelope-seal {
  opacity: 0;
}

.envelope-hint {
  margin: 26px 0 0;
  color: #d5b5d7;
  font-size: 9px;
  letter-spacing: 3px;
}

/* Letter scene */

.letter-scene {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: min(90%, 590px);
  padding-top: 25px;
}

.letter-paper {
  width: 100%;
  padding: clamp(27px, 5vw, 52px);
  border: 1px solid rgba(214, 177, 207, 0.6);
  border-radius: 3px;
  background:
    linear-gradient(rgba(255, 250, 246, 0.97), rgba(250, 239, 239, 0.97));
  color: #594354;
  text-align: left;
  box-shadow: 0 20px 90px rgba(0, 0, 0, 0.3);
}

.letter-kicker {
  margin: 0;
  color: #a77c9e;
  font-family: "Montserrat", sans-serif;
  font-size: 9px;
  letter-spacing: 3px;
  text-align: center;
}

.letter-divider {
  margin: 17px 0 22px;
  color: #bd8db0;
  text-align: center;
}

.letter-heading {
  margin: 0 0 20px;
  color: #76536e;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(28px, 5vw, 38px);
  font-weight: 500;
}

.letter-paragraph {
  margin: 0 0 15px;
  color: #665361;
  font-family: "Cormorant Garamond", serif;
  font-size: clamp(17px, 2.5vw, 20px);
  line-height: 1.55;
}

.letter-signature {
  margin: 24px 0 0;
  color: #76536e;
  font-family: "Cormorant Garamond", serif;
  font-size: 19px;
  font-style: italic;
}

.letter-name {
  margin: 5px 0 0;
  color: #a45f88;
  font-family: "Cormorant Garamond", serif;
  font-size: 26px;
  font-style: italic;
}

.letter-bottom {
  margin: 20px 0 0;
  color: #c9a9d0;
  font-size: 8px;
  letter-spacing: 3px;
}

/* Footer */

.bottom-caption {
  position: absolute;
  bottom: 29px;
  left: 50%;
  display: flex;
  align-items: center;
  gap: 13px;
  transform: translateX(-50%);
  color: rgba(216, 199, 222, 0.48);
  font-size: 8px;
  letter-spacing: 2.5px;
  white-space: nowrap;
}

.caption-star {
  color: #d9a8d9;
  font-size: 12px;
}

.corner-label {
  position: absolute;
  right: 30px;
  bottom: 29px;
  color: rgba(216, 199, 222, 0.45);
  font-size: 9px;
  letter-spacing: 2px;
}

@keyframes glowPulse {
  from {
    transform: scale(0.85);
    opacity: 0.14;
  }
  to {
    transform: scale(1.15);
    opacity: 0.28;
  }
}

@keyframes envelopeFloat {
  0%, 100% {
    transform: translateY(0) rotate(-1deg);
  }
  50% {
    transform: translateY(-13px) rotate(1deg);
  }
}

@media (max-width: 600px) {
  .hero-content,
  .envelope-scene {
    padding-bottom: 65px;
  }

  .eyebrow {
    gap: 9px;
    font-size: 7px;
    letter-spacing: 2.5px;
  }

  .eyebrow-line {
    width: 17px;
  }

  .hero-title {
    letter-spacing: 2px;
  }

  .hero-title span {
    letter-spacing: 9px;
  }

  .hero-description {
    margin-top: 30px;
  }

  .scene-subtitle {
    font-size: 18px;
  }

  .envelope-button {
    transform: scale(1);
  }

  .letter-scene {
    max-height: 85svh;
    overflow-y: auto;
    padding: 20px 0 55px;
  }

  .letter-paper {
    padding: 25px 22px;
  }

  .bottom-caption {
    bottom: 20px;
    font-size: 7px;
    letter-spacing: 1.5px;
  }

  .corner-label {
    right: 15px;
    bottom: 43px;
    font-size: 8px;
  }

  .ambient-glow {
    width: 240px;
    height: 240px;
    filter: blur(80px);
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

/* Mission 09 — Fix envelope paper layering */
.envelope-button.opened .envelope-letter {
  z-index: 6;
}

.envelope-button.opened .envelope-flap {
  z-index: 5;
}

.envelope-button.opened .envelope-front {
  z-index: 3;
}

/* Real portrait letter emerging from the envelope */
.envelope-letter {
  top: 0;
  left: 45px;
  width: 190px;
  height: 245px;
  border: 1px solid rgba(160, 115, 145, 0.15);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}

.envelope-button.opened .envelope-letter {
  z-index: 6;
}

/* Final envelope correction */
.envelope {
  overflow: visible;
}

.envelope-letter {
  top: -0px !important;
  left: 45px !important;
  width: 190px !important;
  height: 160px !important;
  z-index: 1;
  border-radius: 2px;
  background: #fff8f0;
  box-shadow: 0 5px 25px rgba(0, 0, 0, 0.16);
}

.envelope-button.opened .envelope-letter {
  z-index: 6;
}

.envelope-button.opened .envelope-flap {
  z-index: 5;
}

/* MISSION 10 — OUR MEMORIES */
.memories-scene {
  position: relative;
  z-index: 2;
  width: min(1000px, calc(100% - 40px));
  max-height: calc(100vh - 125px);
  margin: auto;
  padding: 25px 8px 35px;
  overflow-y: auto;
  overflow-x: hidden;
  text-align: center;
  scrollbar-width: thin;
  scrollbar-color: rgba(210, 160, 205, 0.45) transparent;
}

.memories-title {
  margin-bottom: 8px;
}

.memories-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  margin: 30px auto;
}

.memory-card {
  min-width: 0;
  overflow: hidden;
  text-align: left;
  background: linear-gradient(145deg, rgba(255, 248, 244, 0.97), rgba(239, 218, 235, 0.96));
  border: 1px solid rgba(255, 255, 255, 0.45);
  border-radius: 5px;
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25);
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.memory-card:hover {
  transform: translateY(-7px) rotate(-1deg);
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
}

.memory-photo-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #21172b;
}

.memory-photo {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s ease;
}

.memory-card:hover .memory-photo {
  transform: scale(1.055);
}

.memory-number {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 5px 9px;
  color: #fff8f5;
  background: rgba(25, 13, 31, 0.58);
  border: 1px solid rgba(255, 255, 255, 0.35);
  font-size: 9px;
  letter-spacing: 2px;
}

.memory-info {
  position: relative;
  min-height: 112px;
  padding: 15px 15px 18px;
  color: #51394f;
}

.memory-info h3 {
  margin: 0 0 8px;
  font-family: Georgia, serif;
  font-size: 17px;
  font-weight: 400;
}

.memory-info p {
  margin: 0;
  color: #80677d;
  font-family: Georgia, serif;
  font-size: 12px;
  line-height: 1.6;
}

.memory-heart {
  display: block;
  margin-top: 9px;
  color: #bd78a7;
  font-size: 14px;
}

.memories-entry-button,
.memories-back-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 44px;
  padding: 0 22px;
  color: #ead1e6;
  background: rgba(255, 255, 255, 0.045);
  border: 1px solid rgba(216, 174, 216, 0.55);
  border-radius: 2px;
  font-size: 10px;
  letter-spacing: 2px;
  cursor: pointer;
  transition: background 0.3s ease, transform 0.3s ease;
}

.memories-entry-button {
  margin-top: 18px;
}

.memories-entry-button span {
  color: #e8a9d0;
  font-size: 18px;
}

.memories-entry-button:hover,
.memories-back-button:hover {
  background: rgba(204, 145, 194, 0.18);
  transform: translateY(-2px);
}

.memories-back-button {
  margin: 0 auto 15px;
}

@media (max-width: 700px) {
  .memories-scene {
    width: calc(100% - 24px);
    max-height: calc(100svh - 105px);
    padding-top: 18px;
  }

  .memories-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 22px auto;
  }

  .memory-info {
    min-height: 105px;
    padding: 11px;
  }

  .memory-info h3 {
    font-size: 14px;
  }

  .memory-info p {
    font-size: 11px;
  }

  .memories-title {
    font-size: clamp(27px, 8vw, 38px);
  }
}

@media (max-width: 380px) {
  .memories-grid {
    grid-template-columns: 1fr;
    max-width: 290px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .memory-card,
  .memory-photo,
  .memories-entry-button,
  .memories-back-button {
    transition: none;
  }
}

