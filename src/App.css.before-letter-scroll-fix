/* MISSION 11 — MUSIC, TERMINAL & NAVIGATION */

.terminal-line {
  min-height: 24px;
  margin: 22px auto;
  color: #cbb6ff;
  font-family: monospace;
  font-size: 12px;
  letter-spacing: 1.5px;
  text-align: center;
}

.terminal-line span {
  color: #8f72d8;
}

.terminal-cursor {
